# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

# --- From Google Cloud Console (APIs & Services > Credentials) ---
# OAuth 2.0 Client ID, type "Desktop app". You can reuse the same OAuth
# client you already created for the other google-*-mcp servers (or Gmail),
# as long as the required APIs are enabled — see README.md step 1
# (this one needs THREE APIs enabled, not just one).
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=

# --- Generated by `npm run auth` (see README.md) ---
GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN=

# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

# --- From Google Cloud Console (APIs & Services > Credentials) ---
# OAuth 2.0 Client ID, type "Desktop app". You can reuse the same OAuth
# client you already created for google-ads-mcp / google-analytics-mcp (or
# Gmail), as long as the "Search Console API" is enabled on that same
# Google Cloud project.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

# --- Generated by `npm run auth` (see README.md) ---
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# --- Optional default site URL (must match exactly how it's registered in ---
# --- Search Console, e.g. "https://www.example.com/" or "sc-domain:example.com") ---
# Tools can still target other sites per call; this is only the fallback
# when a call omits site_url.
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# Banco de dados Postgres (Neon ou Supabase, plano gratuito)
# Neon costuma exigir ?sslmode=require no final da URL
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# NextAuth (Auth.js)
# Gerar com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-valor-aleatorio"

# Usados apenas pelo `npm run seed` para criar o usuário inicial (Felipe)
SEED_USER_EMAIL="voce@exemplo.com"
SEED_USER_PASSWORD="escolha-uma-senha-forte"
SEED_USER_NAME="Felipe"

# Chave simétrica (32 bytes em base64) usada para criptografar o refresh_token
# do Gmail antes de salvar no banco. Gerar com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="gere-com-openssl-rand--base64-32"

# Credenciais OAuth do Google Cloud Console (ver README.md, seção "Gmail").
# A mesma autorização cobre Gmail (ler e-mails marcados) e Drive (anexar
# arquivos escolhidos no Picker), e pode ser repetida pra várias contas.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Em produção: https://SEU_DOMINIO/api/gmail/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# Chave de API do Google (Google Cloud Console → Credenciais → Chave de API,
# restrita ao seu domínio e à "Google Picker API"). Opcional: sem ela o
# seletor de arquivos do Drive ainda funciona pro próprio dono da conta.
NEXT_PUBLIC_GOOGLE_API_KEY=""

# Segredo usado pela Vercel para chamar o cron job com segurança
# Gerar com: openssl rand -hex 32
CRON_SECRET="troque-por-um-valor-aleatorio"

# Chave da API da Anthropic (console.anthropic.com/settings/keys), usada só
# pelo "Ditar pendência" pra organizar o áudio transcrito nos campos certos.
# Sem essa chave o resto do app funciona normal — só esse botão fica desativado.
ANTHROPIC_API_KEY=""

# Chave da OpenAI (platform.openai.com/api-keys), usada só pra transcrever
# áudio (Whisper) em navegadores sem ditado nativo — celular, Safari, Firefox.
# No Chrome/Edge do desktop o ditado usa a API do navegador e não gasta nada.
# Sem essa chave, esses navegadores só ficam sem o ditado; o resto funciona.
OPENAI_API_KEY=""

# Credenciais da Tray Commerce (Central do Parceiro → Chaves de Acesso).
# NUNCA commitar valores reais aqui — só em .env local / env vars da Vercel,
# e marcadas como "Sensitive" na Vercel pra não aparecerem em texto puro
# depois de salvas. Ver README.md, seção 8.
TRAY_STORE_URL=""
TRAY_CONSUMER_KEY=""
TRAY_CONSUMER_SECRET=""
# Em produção: https://SEU_DOMINIO/api/tray/callback (precisa ser HTTPS —
# a Tray exige certificado válido pro callback do OAuth)
TRAY_CALLBACK_URL=""

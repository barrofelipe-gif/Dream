# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

# --- From Google Cloud Console (APIs & Services > Credentials) ---
# OAuth 2.0 Client ID, type "Desktop app". You can reuse the same OAuth
# client you already created for google-ads-mcp (or Gmail), as long as the
# "Google Analytics Data API" and "Google Analytics Admin API" are enabled
# on that same Google Cloud project.
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=

# --- Generated by `npm run auth` (see README.md) ---
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# --- Optional default GA4 property id (the numeric id, e.g. "properties/419011003" or just "419011003") ---
# Tools can still target other properties per call; this is only the fallback
# when a call omits property_id.
GOOGLE_ANALYTICS_PROPERTY_ID=

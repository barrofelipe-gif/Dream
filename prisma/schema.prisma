// Painel de Pendências — schema do banco de dados
// Postgres gerenciado (Neon ou Supabase, plano gratuito)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  membro
}

enum Category {
  processos
  bff
  emails
  viagens
}

enum BffSub {
  financeiro
  fornecedor
  produto
  outro
}

enum Priority {
  alta
  media
  baixa
}

enum Recurring {
  none
  daily
  weekly
  monthly
}

enum Source {
  manual
  gmail
}

// Semáforo dos blocos de cada setor — mesma paleta de src/lib/sectorStatus.ts.
enum MetricStatus {
  good
  warning
  critical
  unknown
}

// Setores da aba "BFF Fitness" (empresa) — ver spec do painel de setores.
// RH fica de fora por enquanto (escopo ainda não definido).
enum Sector {
  financeiro
  marketing_vendas
  estoque
  logistica
  clientes
  suporte
  juridico
  desenvolvimento_produto
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(admin) // já nasce pronto pra Fase 2 (admin | membro)
  createdAt      DateTime @default(now())

  items            Item[]            @relation("OwnedItems")
  assignedItems    Item[]            @relation("AssignedItems")
  columns          Column[]
  gmailConnections GmailConnection[]
  sectorAccess     SectorAccess[]
}

// Quais setores da aba BFF Fitness cada usuário enxerga. Admin (role=admin)
// tem acesso total independente dessa tabela — ela só importa pra role=membro.
model SectorAccess {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  sector   Sector

  createdAt DateTime @default(now())

  @@unique([userId, sector])
}

// Um "bloco" dentro de um setor (ex: "Fluxo de caixa" dentro de Financeiro).
// Enquanto não tem fonte de dado automática (Tray etc.) ligada, quem tem
// acesso ao setor preenche na mão — mesmo semáforo, trocado por dado real
// depois sem mudar a tela. blockKey = a mesma string do SECTOR_BLOCKS no
// código (não é enum pra não travar deploy toda vez que a lista mudar).
model SectorMetric {
  id            String       @id @default(cuid())
  sector        Sector
  blockKey      String
  label         String
  status        MetricStatus @default(unknown)
  value         String?      // texto livre — "R$ 42.000", "18 dias", etc.
  note          String?
  updatedById   String?
  updatedAt     DateTime     @updatedAt
  createdAt     DateTime     @default(now())

  @@unique([sector, blockKey])
  @@index([sector])
}

// Coluna do quadro Kanban — escopada por categoria, editável pelo usuário
// (criar, renomear, reordenar). Cada categoria nasce com 3 colunas padrão
// (Pendente / Em andamento / Concluído), criadas sob demanda.
model Column {
  id        String   @id @default(cuid())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String

  category  Category
  name      String
  order     Int
  isDone    Boolean  @default(false) // marca a(s) coluna(s) que contam como "concluído"

  items     Item[]
  createdAt DateTime @default(now())

  @@index([ownerId, category, order])
}

model Item {
  id            String     @id @default(cuid())
  owner         User       @relation("OwnedItems", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       String

  // Quem atribuiu essa pendência a outra pessoa (null = a pessoa criou pra
  // ela mesma). Junto com createdAt/completedAt dá o histórico de "enviei
  // em X, ela concluiu em Y" pedido pelo usuário.
  assignedBy    User?      @relation("AssignedItems", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById  String?

  category      Category
  bffSub        BffSub?

  column        Column     @relation(fields: [columnId], references: [id])
  columnId      String

  title         String
  detail        String?

  // campos específicos de "processos"
  company       String?
  lawyer        String?
  processNumber String?
  lastMovement  String?

  due           DateTime?
  priority      Priority   @default(media)
  recurring     Recurring  @default(none)

  source        Source     @default(manual)
  sourceRef     String?    // id da thread/e-mail no Gmail, quando source = gmail

  // Arquivo do Google Drive vinculado à pendência (escolhido pelo Picker).
  // Guardamos só a referência — o arquivo continua vivendo no Drive.
  attachmentFileId String?
  attachmentName   String?
  attachmentUrl    String?

  completedAt   DateTime?  // marcado sozinho quando a coluna vira isDone
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  @@index([ownerId, category])
  @@index([columnId])
  @@index([due])
  @@index([sourceRef])
  @@index([assignedById])
}

// Uma linha por conta Google conectada. O usuário pode conectar várias
// (pessoal, empresa, fornecedor) — cada uma com seu próprio refresh_token,
// cobrindo Gmail + Drive da mesma autorização.
model GmailConnection {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  refreshToken  String   // criptografado (AES-256-GCM) antes de salvar — ver src/lib/crypto.ts
  email         String   // conta Google conectada, descoberta no callback via userinfo
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())

  @@unique([userId, email])
  @@index([userId])
}

// Registro de cada chamada ao servidor MCP (assistentes externos conectados).
// Serve pra duas coisas: auditoria — dá pra ver o que foi consultado e quando —
// e o limite de requisições, que conta as chamadas recentes desta tabela.
// Não guarda o token nem o conteúdo devolvido, só o que foi pedido.
model McpAccessLog {
  id        String   @id @default(cuid())
  tool      String   // nome da ferramenta chamada, ou o método MCP
  ok        Boolean  @default(true)
  blocked   Boolean  @default(false) // true = barrado pelo limite de requisições
  ip        String?  // origem, pra investigar uso indevido
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Code de autorização do mini fluxo OAuth do MCP (ver src/app/api/mcp/oauth).
// O Claude.ai, no conector personalizado, só manda o cabeçalho Authorization
// de forma confiável quando o servidor fala OAuth de verdade — cabeçalho
// custom configurado na tela não estava chegando. Esse fluxo existe só pra
// satisfazer esse protocolo: a "senha" continua sendo o login normal do
// painel (NextAuth) — /api/mcp/oauth/authorize fica atrás do middleware de
// sessão — e o token final devolvido é sempre o mesmo MCP_TOKEN estático, o
// código aqui é só a ponte de curta duração (5min, uso único) do handshake.
model McpAuthCode {
  id                  String   @id @default(cuid())
  code                String   @unique // valor aleatório devolvido na URL de callback
  clientId             String
  redirectUri          String
  codeChallenge         String
  codeChallengeMethod   String  @default("S256")
  used                 Boolean @default(false)
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([expiresAt])
}

// Conexão com o bling-mcp-server já existente (projeto separado na Vercel,
// https://bling-mcp-server.vercel.app) — não duplica a autorização com a
// Bling: o painel entra como mais um "cliente" OAuth desse servidor (do
// mesmo jeito que o Claude.ai já entra), pegando seu próprio par de token,
// independente do grant que o Claude.ai usa. Reaproveita 100% o trabalho
// existente (nenhum projeto novo na Vercel, nenhum redirect URI novo
// cadastrado na Bling).
model BlingConnection {
  id                     String   @id @default(cuid())

  accessToken            String   // criptografado (AES-256-GCM) — ver src/lib/crypto.ts
  refreshToken           String   // criptografado — a Bling roda token rotativo, o antigo vira inválido a cada refresh
  accessTokenExpiresAt   DateTime

  connectedByUserId      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Conexão com a API da Tray Commerce — é da EMPRESA, não de um usuário
// (por isso não tem @@unique([userId]) tipo GmailConnection: existe no
// máximo uma linha aqui, mantida por quem clicou em "Conectar" por último).
model TrayConnection {
  id                       String   @id @default(cuid())

  apiAddress               String   // ex: https://loja-s.tray.com.br/web_api — vem do callback/token, varia por loja
  storeId                  String?

  accessToken              String   // criptografado (AES-256-GCM) — ver src/lib/crypto.ts
  refreshToken             String   // criptografado (AES-256-GCM)
  accessTokenExpiresAt     DateTime
  refreshTokenExpiresAt    DateTime

  connectedByUserId        String?  // quem autorizou (auditoria só; sem relation pra não travar a Tray a 1 usuário)
  lastSyncAt               DateTime?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ── Robô de DM do Instagram ──────────────────────────────────────────────
// Conversas ficam AQUI, separadas das perguntas que aparecem nas páginas dos
// produtos (essas moram no bff-avaliacoes, que o robô só lê).

// Uma conta do Instagram ligada a uma loja: cada conta responde com a base
// de perguntas e respostas da sua loja.
model InstagramAccount {
  id           String   @id @default(cuid())
  igUserId     String   @unique // id da conta profissional (é o "recipient" no webhook)
  username     String?
  loja         String   // "bff" | "moranga" — qual base do bff-avaliacoes usar
  accessToken  String   // criptografado (AES-256-GCM) — ver src/lib/crypto.ts
  active       Boolean  @default(true)

  conversations IgConversation[]
  automacoes    IgAutomacao[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  transmissoes IgTransmissao[]
  sequencias   IgSequencia[]
  campos       IgCampo[]
  regras          IgRegra[]
  respostasSalvas IgRespostaSalva[]
  fluxos          IgFluxo[]
}

model IgConversation {
  id                    String   @id @default(cuid())
  accountId             String
  account               InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  igScopedUserId        String   // id da pessoa no Instagram (escopo do app)

  // BOT: robô responde · NEEDS_HUMAN: robô não achou resposta, aguardando o
  // Felipe/equipe · HUMAN: um humano assumiu (robô fica quieto) · CLOSED
  status                String   @default("BOT")
  lastCustomerMessageAt DateTime? // base da janela de 24h da Meta
  assumidaEm            DateTime? // quando uma atendente assumiu (status HUMAN); o robô só volta 24h depois da última atividade dela
  naoLida               Boolean  @default(false) // transferida para a equipe e ainda não aberta
  tags                  String[] @default([])    // etiquetas (robô e equipe), como as tags do ManyChat
  campos                Json     @default("{}")  // valores dos campos personalizados (IgCampo.nome -> valor), como no ManyChat

  // Perfil do cliente no Instagram (User Profile API), renovado a cada ~12h.
  nome                  String?
  username              String?
  fotoUrl               String?  // URL assinada da Meta, expira: por isso é renovada
  seguidores            Int?
  verificado            Boolean  @default(false)
  seguePagina           Boolean? // o cliente já segue a conta da loja?
  perfilEm              DateTime?

  messages              IgMessage[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([accountId, igScopedUserId])
  @@index([status, updatedAt])
}

model IgMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    IgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction       String   // "IN" (cliente) | "OUT" (nós)
  source          String   // "CLIENTE" | "BOT" | "HUMANO"
  text            String
  metaMessageId   String?  @unique // idempotência: a Meta reenvia o mesmo webhook

  // Só nas respostas do robô: qual entrada da base foi usada e com que certeza.
  matchedKind     String?  // "faq" | "pergunta"
  matchedId       Int?
  confidence      String?  // "alta" | "media" | "baixa"

  createdAt       DateTime @default(now())

  @@index([conversationId, createdAt])
}

// Automação de boas-vindas do Instagram (uma linha por loja). Sem linha, valem os padrões do código.
model IgBoasVindas {
  id          String   @id @default(cuid())
  loja        String   @unique // "bff" | "moranga"
  ativo       Boolean  @default(true)
  mensagem    String   // 1ª mensagem ao primeiro contato; {nome} = primeiro nome do cliente
  botao       String   // texto do botão de resposta rápida (até 20 caracteres)
  pedirSeguir Boolean  @default(true)
  textoSeguir String   // convite para seguir a loja (só para quem ainda não segue)
  infoTexto   String   @default("") // informações enviadas ao tocar no botão; vazio = o robô monta a partir da base
  linkTitulo  String   @default("")
  linkUrl     String   @default("")
  iniciadores String   @default("") // perguntas do chat novo (até 4, uma por linha)
  menu        String   @default("") // menu principal (até 5 linhas: "Título | https://link" ou só "Título")
  updatedAt   DateTime @updatedAt
}

// Automações do Instagram (gatilho -> ação). Hoje: comentário numa publicação -> resposta pública + DM.
model IgAutomacao {
  id             String   @id @default(cuid())
  accountId      String
  account        InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nome           String
  tipo           String   @default("comentario")
  ativo          Boolean  @default(false)

  // Gatilho
  midiaId        String   @default("") // "" = qualquer publicação ou reel
  midiaLegenda   String   @default("") // só para mostrar no painel
  midiaThumb     String   @default("")
  palavras       String   @default("") // separadas por vírgula; vazio = qualquer comentário
  modoPalavra    String   @default("contem") // "contem" | "exata"

  // Ações
  respostasPublicas String @default("") // variantes, uma por linha; vazio = não responde em público
  dmTexto        String   // mensagem enviada no direct; {nome} = primeiro nome
  dmBotaoTitulo  String   @default("")
  dmBotaoUrl     String   @default("")
  exigirSeguir   Boolean  @default(false)
  seguirTexto    String   @default("")
  seguirBotao    String   @default("Já segui")

  execucoes      Int      @default(0)
  execucoesLista IgAutomacaoExec[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId, ativo])
}

// Uma execução = um comentário atendido (evita responder o mesmo comentário duas vezes).
model IgAutomacaoExec {
  id            String   @id @default(cuid())
  automacaoId   String
  automacao     IgAutomacao @relation(fields: [automacaoId], references: [id], onDelete: Cascade)
  commentId     String
  igUserId      String   // quem comentou (id no escopo do app)
  username      String?
  etapa         String   @default("enviado") // "enviado" | "aguardando_seguir" | "liberado"
  createdAt     DateTime @default(now())

  @@unique([automacaoId, commentId])
  @@index([automacaoId, createdAt])
}

// ── Publicador multi-rede ─────────────────────────────────────────────────────
// Uma conta/página/canal de uma rede social, ligada a uma loja. Tokens sempre criptografados.
model SocialConta {
  id           String   @id @default(cuid())
  rede         String   // "instagram" | "facebook" | "tiktok" | "youtube" | "pinterest"
  loja         String   // "bff" | "moranga"
  externoId    String   // id da conta/página/canal na rede
  nome         String?
  username     String?
  fotoUrl      String?
  accessToken  String   // criptografado (AES-256-GCM)
  refreshToken String?  // criptografado
  expiraEm     DateTime?
  escopos      String   @default("")
  ativo        Boolean  @default(true)
  extra        String   @default("{}") // JSON livre da rede (ex: pageId, id do IG ligado)

  alvos        SocialPostAlvo[]
  metricasDia  SocialMetricaConta[]
  metricasPost SocialMetricaPost[]
  metricasPublico SocialMetricaPublico[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([rede, externoId])
  @@index([loja, rede])
}

// Uma postagem criada no painel, que pode sair em várias redes de uma vez.
model SocialPost {
  id           String   @id @default(cuid())
  titulo       String   @default("")
  legenda      String   @default("")
  tipo         String   @default("imagem") // "imagem" | "video" | "carrossel" | "texto"
  midias       String   @default("[]")     // JSON: [{ url, tipo: "imagem"|"video", nome? }]
  porRede      String   @default("{}")     // JSON: ajustes por rede { tiktok: { legenda, ... } }
  agendadoPara DateTime?
  status       String   @default("RASCUNHO") // RASCUNHO | AGENDADO | PUBLICANDO | PUBLICADO | PARCIAL | ERRO
  criadoPor    String?

  alvos        SocialPostAlvo[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, agendadoPara])
}

// Uma postagem em UMA conta (resultado por rede).
model SocialPostAlvo {
  id            String   @id @default(cuid())
  postId        String
  post          SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  contaId       String
  conta         SocialConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  status        String   @default("PENDENTE") // PENDENTE | PUBLICANDO | PUBLICADO | ERRO
  externoPostId String?
  url           String?
  erro          String?
  tentativas    Int      @default(0)
  publicadoEm   DateTime?

  @@unique([postId, contaId])
}

// ── Métricas das redes sociais ──────────────────────────────────────────────

// Um registro por conta e dia (métricas da conta inteira).
model SocialMetricaConta {
  id                String      @id @default(cuid())
  contaId           String
  conta             SocialConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  data              DateTime // dia (00:00 UTC do dia em Brasília)
  alcance           Int         @default(0)
  visualizacoes     Int         @default(0)
  visitasPerfil     Int         @default(0)
  toquesLink        Int         @default(0) // toques nos links do perfil (link da bio)
  contasEngajadas   Int         @default(0)
  interacoes        Int         @default(0)
  seguidores        Int? // total de seguidores no momento da coleta (só o dia da coleta)
  curtidas          Int         @default(0)
  comentarios       Int         @default(0)
  compartilhamentos Int         @default(0)
  salvamentos       Int         @default(0)
  bruto             String      @default("{}") // JSON com tudo que a API devolveu
  coletadoEm        DateTime    @default(now())

  @@unique([contaId, data])
  @@index([contaId, data])
}

// Uma linha por mídia publicada.
model SocialMetricaPost {
  id                     String      @id @default(cuid())
  contaId                String
  conta                  SocialConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  externoId              String
  tipo                   String // foto | reel | carrossel | story
  legenda                String      @default("")
  permalink              String?
  miniatura              String?
  publicadoEm            DateTime
  hora                   Int // 0–23, fuso de Brasília
  diaSemana              Int // 0 = domingo … 6 = sábado, fuso de Brasília
  alcance                Int         @default(0)
  visualizacoes          Int         @default(0)
  curtidas               Int         @default(0)
  comentarios            Int         @default(0)
  compartilhamentos      Int         @default(0)
  salvamentos            Int         @default(0)
  interacoes             Int         @default(0)
  seguidoresGanhos       Int         @default(0)
  visitasPerfil          Int         @default(0)
  cliquesLinkBio         Int         @default(0)
  tempoMedioAssistidoSeg Float?
  bruto                  String      @default("{}") // JSON com tudo que a API devolveu (mídia + insights)
  coletadoEm             DateTime    @default(now())

  @@unique([contaId, externoId])
  @@index([contaId, publicadoEm])
}

// Público da conta: um registro por conta e dia da coleta.
model SocialMetricaPublico {
  id         String      @id @default(cuid())
  contaId    String
  conta      SocialConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  data       DateTime
  bruto      String      @default("{}") // { seguidores: {age,gender,city,country}, engajados: {...}, alcancados: {...}, avisos: [] }
  coletadoEm DateTime    @default(now())

  @@unique([contaId, data])
}

// Transmissao (mensagem em massa) no Instagram: so chega a quem falou com a loja nas ultimas 24h (regra da Meta).
model IgTransmissao {
  id           String   @id @default(cuid())
  accountId    String
  account      InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nome         String
  texto        String
  incluirTags  String[] @default([])
  excluirTags  String[] @default([])
  status       String   @default("ENVIANDO") // ENVIANDO | CONCLUIDA | CANCELADA
  total        Int      @default(0)
  enviadas     Int      @default(0)
  falhas       Int      @default(0)
  alvos        IgTransmissaoAlvo[]
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

model IgTransmissaoAlvo {
  id             String   @id @default(cuid())
  transmissaoId  String
  transmissao    IgTransmissao @relation(fields: [transmissaoId], references: [id], onDelete: Cascade)
  conversationId String
  status         String   @default("PENDENTE") // PENDENTE | ENVIADA | FALHOU | EXPIRADA
  erro           String?

  @@index([transmissaoId, status])
}

// Campo personalizado dos contatos do Instagram (como os "custom fields" do ManyChat).
// Os valores ficam em IgConversation.campos, chaveados pelo nome do campo.
model IgCampo {
  id        String   @id @default(cuid())
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nome      String
  tipo      String   @default("TEXTO") // TEXTO | NUMERO | DATA | SIM_NAO
  createdAt DateTime @default(now())

  @@unique([accountId, nome])
}

// Sequência (drip) do Instagram, como no ManyChat: passos com atraso entre eles.
// Regra da Meta: só envia dentro da janela de 24h desde a última mensagem do cliente; fora dela o inscrito fica PARADA.
model IgSequencia {
  id                 String   @id @default(cuid())
  accountId          String
  account            InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nome               String
  ativa              Boolean  @default(true)
  passos             Json     // [{ atrasoMinutos: number, texto: string }] — atraso contado a partir do passo anterior (ou da inscrição)
  pararSeResponder   Boolean  @default(true)
  etiquetaAoEntrar   String?
  etiquetaAoConcluir String?
  inscritos          IgSequenciaInscrito[]
  createdAt          DateTime @default(now())

  @@index([accountId, createdAt])
}

model IgSequenciaInscrito {
  id             String      @id @default(cuid())
  sequenciaId    String
  sequencia      IgSequencia @relation(fields: [sequenciaId], references: [id], onDelete: Cascade)
  conversationId String
  passoAtual     Int         @default(0) // índice do próximo passo a enviar
  proximoEm      DateTime
  status         String      @default("ATIVA") // ATIVA | CONCLUIDA | PARADA
  motivo         String?     // por que parou (fora da janela, respondeu, manual, falha…)
  ultimoEnvioEm  DateTime?
  createdAt      DateTime    @default(now())

  @@unique([sequenciaId, conversationId])
  @@index([status, proximoEm])
  @@index([conversationId, status])
}

// Regra de automação do Instagram ("quando X acontecer, faça Y"), como as Rules do ManyChat.
// quando: { tipo: "ETIQUETA_APLICADA" | "ETIQUETA_REMOVIDA" | "PALAVRA_NA_MENSAGEM" | "CONVERSA_TRANSFERIDA", valor?: string }
// fazer:  [{ tipo: "ADICIONAR_ETIQUETA" | "REMOVER_ETIQUETA", valor }, { tipo: "ENVIAR_MENSAGEM", texto }, { tipo: "CHAMAR_ATENDENTE" | "ENCERRAR" | "DEVOLVER_AO_ROBO" }, { tipo: "NOTIFICAR_EQUIPE", motivo? }]
model IgRegra {
  id        String   @id @default(cuid())
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nome      String
  ativa     Boolean  @default(true)
  quando    Json
  fazer     Json     @default("[]")
  execucoes IgRegraExec[]
  createdAt DateTime @default(now())

  @@index([accountId, ativa])
}

// Uma execução de regra numa conversa (trava contra laço: a mesma regra não roda de novo na mesma conversa por 1 minuto).
model IgRegraExec {
  id             String   @id @default(cuid())
  regraId        String
  regra          IgRegra  @relation(fields: [regraId], references: [id], onDelete: Cascade)
  conversationId String
  createdAt      DateTime @default(now())

  @@index([regraId, conversationId, createdAt])
}

// Respostas salvas (atalhos da equipe na caixa de entrada). accountId vazio = vale para todas as contas.
model IgRespostaSalva {
  id        String   @id @default(cuid())
  accountId String?
  account   InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  atalho    String   // ex.: "frete" (digitado como /frete)
  titulo    String
  texto     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

// E-mails da equipe para avisos do Instagram. Hoje o projeto não tem envio de e-mail (o Gmail está só como leitura),
// então o aviso vai para o sino do painel (IgNotificacao); estes endereços ficam guardados para quando houver envio.
model IgConfigNotificacao {
  id        String   @id @default(cuid())
  email     String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Aviso do sino: conversa que precisa de alguém da equipe.
model IgNotificacao {
  id             String   @id @default(cuid())
  conversationId String
  motivo         String
  lida           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([lida, createdAt])
  @@index([conversationId, createdAt])
}

// Fluxo visual do Instagram (Flow Builder do ManyChat): blocos ligados por linhas.
// gatilho = cópia do bloco GATILHO do grafo (para buscar rápido quais fluxos disparam).
// grafo = { nos: [{ id, tipo, x, y, dados }], ligacoes: [{ id, de, saida, para }] } — ver src/lib/igFluxosModelo.ts
model IgFluxo {
  id        String   @id @default(cuid())
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nome      String
  ativo     Boolean  @default(false)
  gatilho   Json     @default("{}")
  grafo     Json     @default("{}")
  execs     IgFluxoExec[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, ativo])
}

// Uma pessoa passando por um fluxo. Regra da Meta: só envia dentro da janela de 24h; fora dela vira CANCELADO.
model IgFluxoExec {
  id             String   @id @default(cuid())
  fluxoId        String
  fluxo          IgFluxo  @relation(fields: [fluxoId], references: [id], onDelete: Cascade)
  conversationId String
  noAtual        String
  variaveis      Json     @default("{}")
  status         String   @default("ATIVO") // ATIVO | ESPERANDO_RESPOSTA | ESPERANDO_TEMPO | CONCLUIDO | CANCELADO
  retomarEm      DateTime? // ESPERANDO_TEMPO: quando continuar · ESPERANDO_RESPOSTA: prazo (fim da janela)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, retomarEm])
  @@index([conversationId, status])
}

// Mensagem de DM marcada para sair mais tarde (por exemplo, o convite do grupo VIP ~2 min depois do pitch de atacado).
// O agendador de 5 min (cron publicar-agendados) envia; a reserva PENDENTE -> ENVIANDO é atômica.
model IgEnvioAgendado {
  id             String   @id @default(cuid())
  conversationId String
  texto          String
  links          Json     @default("[]") // [{ title, url }] (até 3 botões de link)
  kind           String   @default("agendada")
  enviarEm       DateTime
  status         String   @default("PENDENTE") // PENDENTE | ENVIANDO | ENVIADA | CANCELADA | EXPIRADA | FALHOU
  erro           String?
  createdAt      DateTime @default(now())

  @@index([status, enviarEm])
  @@index([conversationId, status])
}

// ── Messenger (mensagens da Página do Facebook) ─────────────────────────────
// Separado do Instagram: outra API (Messenger Platform), outro token (o da Página, em SocialConta) e outras regras.
// Cada conversa é de uma Página só, e a Página é de uma loja só (BFF e Moranga nunca se misturam).
model FbConversa {
  id                    String   @id @default(cuid())
  contaId               String   // SocialConta (rede "facebook") da Página
  loja                  String   // "bff" | "moranga" (copiado da Página)
  paginaId              String   // id da Página no Facebook
  psid                  String   // id da pessoa nesta Página (Page-scoped ID)
  nome                  String?
  fotoUrl               String?
  // BOT: robô pode responder (se ligado na Página) · NEEDS_HUMAN: aguardando atendente · HUMAN: atendente assumiu · CLOSED
  status                String   @default("BOT")
  naoLida               Boolean  @default(false)
  lastCustomerMessageAt DateTime? // base da janela de 24h do Messenger
  mensagens             FbMensagem[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([paginaId, psid])
  @@index([loja, updatedAt])
}

model FbMensagem {
  id            String   @id @default(cuid())
  conversaId    String
  conversa      FbConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  direction     String   // "IN" (cliente) | "OUT" (nós)
  source        String   // "CLIENTE" | "BOT" | "HUMANO"
  text          String
  metaMessageId String?  @unique // idempotência (webhook reenviado, sincronização repetida)
  matchedKind   String?  // só no robô: "faq" | "pergunta" | "saudacao" | "atendente"
  createdAt     DateTime @default(now())

  @@index([conversaId, createdAt])
}

// Robô do Messenger ligado/desligado por Página (fica fora do SocialConta.extra, que o reconectar regrava).
model FbPaginaConfig {
  paginaId  String   @id
  roboAtivo Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Painel de Pendências — schema do banco de dados
// Postgres gerenciado (Neon ou Supabase, plano gratuito)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  membro
}

enum Category {
  processos
  bff
  emails
  viagens
}

enum BffSub {
  financeiro
  fornecedor
  produto
  outro
}

enum Priority {
  alta
  media
  baixa
}

enum Recurring {
  none
  daily
  weekly
  monthly
}

enum Source {
  manual
  gmail
}

// Semáforo dos blocos de cada setor — mesma paleta de src/lib/sectorStatus.ts.
enum MetricStatus {
  good
  warning
  critical
  unknown
}

// Setores da aba "BFF Fitness" (empresa) — ver spec do painel de setores.
// RH fica de fora por enquanto (escopo ainda não definido).
enum Sector {
  financeiro
  marketing_vendas
  estoque
  logistica
  clientes
  suporte
  juridico
  desenvolvimento_produto
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(admin) // já nasce pronto pra Fase 2 (admin | membro)
  createdAt      DateTime @default(now())

  items            Item[]            @relation("OwnedItems")
  assignedItems    Item[]            @relation("AssignedItems")
  columns          Column[]
  gmailConnections GmailConnection[]
  sectorAccess     SectorAccess[]
}

// Quais setores da aba BFF Fitness cada usuário enxerga. Admin (role=admin)
// tem acesso total independente dessa tabela — ela só importa pra role=membro.
model SectorAccess {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  sector   Sector

  createdAt DateTime @default(now())

  @@unique([userId, sector])
}

// Um "bloco" dentro de um setor (ex: "Fluxo de caixa" dentro de Financeiro).
// Enquanto não tem fonte de dado automática (Tray etc.) ligada, quem tem
// acesso ao setor preenche na mão — mesmo semáforo, trocado por dado real
// depois sem mudar a tela. blockKey = a mesma string do SECTOR_BLOCKS no
// código (não é enum pra não travar deploy toda vez que a lista mudar).
model SectorMetric {
  id            String       @id @default(cuid())
  sector        Sector
  blockKey      String
  label         String
  status        MetricStatus @default(unknown)
  value         String?      // texto livre — "R$ 42.000", "18 dias", etc.
  note          String?
  updatedById   String?
  updatedAt     DateTime     @updatedAt
  createdAt     DateTime     @default(now())

  @@unique([sector, blockKey])
  @@index([sector])
}

// Coluna do quadro Kanban — escopada por categoria, editável pelo usuário
// (criar, renomear, reordenar). Cada categoria nasce com 3 colunas padrão
// (Pendente / Em andamento / Concluído), criadas sob demanda.
model Column {
  id        String   @id @default(cuid())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String

  category  Category
  name      String
  order     Int
  isDone    Boolean  @default(false) // marca a(s) coluna(s) que contam como "concluído"

  items     Item[]
  createdAt DateTime @default(now())

  @@index([ownerId, category, order])
}

model Item {
  id            String     @id @default(cuid())
  owner         User       @relation("OwnedItems", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       String

  // Quem atribuiu essa pendência a outra pessoa (null = a pessoa criou pra
  // ela mesma). Junto com createdAt/completedAt dá o histórico de "enviei
  // em X, ela concluiu em Y" pedido pelo usuário.
  assignedBy    User?      @relation("AssignedItems", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById  String?

  category      Category
  bffSub        BffSub?

  column        Column     @relation(fields: [columnId], references: [id])
  columnId      String

  title         String
  detail        String?

  // campos específicos de "processos"
  company       String?
  lawyer        String?
  processNumber String?
  lastMovement  String?

  due           DateTime?
  priority      Priority   @default(media)
  recurring     Recurring  @default(none)

  source        Source     @default(manual)
  sourceRef     String?    // id da thread/e-mail no Gmail, quando source = gmail

  // Arquivo do Google Drive vinculado à pendência (escolhido pelo Picker).
  // Guardamos só a referência — o arquivo continua vivendo no Drive.
  attachmentFileId String?
  attachmentName   String?
  attachmentUrl    String?

  completedAt   DateTime?  // marcado sozinho quando a coluna vira isDone
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  @@index([ownerId, category])
  @@index([columnId])
  @@index([due])
  @@index([sourceRef])
  @@index([assignedById])
}

// Uma linha por conta Google conectada. O usuário pode conectar várias
// (pessoal, empresa, fornecedor) — cada uma com seu próprio refresh_token,
// cobrindo Gmail + Drive da mesma autorização.
model GmailConnection {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  refreshToken  String   // criptografado (AES-256-GCM) antes de salvar — ver src/lib/crypto.ts
  email         String   // conta Google conectada, descoberta no callback via userinfo
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())

  @@unique([userId, email])
  @@index([userId])
}

// Registro de cada chamada ao servidor MCP (assistentes externos conectados).
// Serve pra duas coisas: auditoria — dá pra ver o que foi consultado e quando —
// e o limite de requisições, que conta as chamadas recentes desta tabela.
// Não guarda o token nem o conteúdo devolvido, só o que foi pedido.
model McpAccessLog {
  id        String   @id @default(cuid())
  tool      String   // nome da ferramenta chamada, ou o método MCP
  ok        Boolean  @default(true)
  blocked   Boolean  @default(false) // true = barrado pelo limite de requisições
  ip        String?  // origem, pra investigar uso indevido
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Conexão com a API da Tray Commerce — é da EMPRESA, não de um usuário
// (por isso não tem @@unique([userId]) tipo GmailConnection: existe no
// máximo uma linha aqui, mantida por quem clicou em "Conectar" por último).
model TrayConnection {
  id                       String   @id @default(cuid())

  apiAddress               String   // ex: https://loja-s.tray.com.br/web_api — vem do callback/token, varia por loja
  storeId                  String?

  accessToken              String   // criptografado (AES-256-GCM) — ver src/lib/crypto.ts
  refreshToken             String   // criptografado (AES-256-GCM)
  accessTokenExpiresAt     DateTime
  refreshTokenExpiresAt    DateTime

  connectedByUserId        String?  // quem autorizou (auditoria só; sem relation pra não travar a Tray a 1 usuário)
  lastSyncAt               DateTime?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

# --- From Google Cloud Console (APIs & Services > Credentials) ---
# OAuth 2.0 Client ID, type "Desktop app"
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# --- From the Google Ads API Center (ads.google.com > Tools > API Center) ---
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Generated by `npm run auth` (see README.md) ---
GOOGLE_ADS_REFRESH_TOKEN=

# --- The Google Ads account you manage, digits only, no dashes ---
# If you log in through a manager/MCC account, set GOOGLE_ADS_LOGIN_CUSTOMER_ID
# to the MCC id and GOOGLE_ADS_CUSTOMER_ID to the specific client account id
# you want the server to default to (tools can still target other ids per call).
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

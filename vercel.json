{
  "env": {
    "TELEGRAM_NETWORK_PAUSED": "0"
  },
  "functions": {
    "src/app/api/telegram/**/route.ts": {
      "regions": ["gru1"],
      "functionFailoverRegions": []
    },
    "src/app/.well-known/workflow/v1/flow/route.js": {
      "regions": ["gru1"],
      "functionFailoverRegions": []
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-gmail",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/sync-tray",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/estoque-avaliacoes",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/publicar-agendados",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/coletar-metricas",
      "schedule": "0 10 * * *"
    }
  ]
}

{
  "name": "google-pagespeed-mcp",
  "version": "1.0.0",
  "description": "MCP server for Google PageSpeed Insights — performance, accessibility, SEO and best-practices audits for any public URL. No OAuth needed, just a free API key.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "google-pagespeed-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}

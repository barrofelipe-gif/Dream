# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.

# Optional but recommended: a free API key raises the rate limit a lot
# (unkeyed requests are capped very low). Get one at:
# https://console.cloud.google.com/apis/credentials — no OAuth client
# needed, just "Create Credentials > API key", after enabling the
# "PageSpeed Insights API" on the project.
GOOGLE_PAGESPEED_API_KEY=

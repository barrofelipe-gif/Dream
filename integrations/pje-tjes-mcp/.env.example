# Copie este arquivo para .env e preencha com seus dados.
# NUNCA faça commit do arquivo .env real — ele contém segredos (senha do
# certificado digital). O .gitignore deste diretório já bloqueia isso.

# URL do PJe do TJES
PJE_BASE_URL=https://pje.tjes.jus.br
PJE_APP_NAME=pje-tjes-1g

# Certificado digital A1 (arquivo .pfx/.p12) — funciona em Linux/Mac/Windows.
# Caminho ABSOLUTO para o arquivo no seu computador. Não coloque o arquivo
# .pfx dentro deste repositório.
PJE_CERTIFICATE_PFX_PATH=
PJE_CERTIFICATE_PFX_PASSWORD=

# Certificado digital A3 (token/smartcard) — só funciona em Windows, porque
# depende do utilitário "certutil" do Windows para ler o repositório de
# certificados do sistema. Em Linux/Mac deixe em branco e use o A1 (PFX) acima.
PJE_CERTIFICATE_THUMBPRINT=

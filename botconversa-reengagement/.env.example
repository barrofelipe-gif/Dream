# URL base da API do BotConversa (confirmada no Swagger: /api/v1/webhook)
BOTCONVERSA_API_BASE=https://backend.botconversa.com.br/api/v1/webhook

# Chave da API (Configurações -> Integrações -> API, no painel do BotConversa)
BOTCONVERSA_API_KEY=coloque_sua_chave_aqui

# Nome do header de autenticação exigido pelo Swagger (confirmado em
# "Authorize" -> Api key (apiKey) -> Name: API-KEY, In: header).
BOTCONVERSA_AUTH_HEADER_NAME=API-KEY

# Prefixo antes da chave dentro do header, se houver (ex: "Bearer "). Deixe vazio se não houver.
BOTCONVERSA_AUTH_HEADER_PREFIX=

# ID da tag "sem-resposta" dentro do BotConversa (pegue via GET /tags/)
TAG_SEM_RESPOSTA_ID=coloque_o_id_da_tag_aqui

# Segredo simples pra validar que só o BotConversa (via bloco de webhook do fluxo)
# consegue chamar o endpoint de entrada deste serviço. Invente uma string longa e aleatória.
WEBHOOK_SHARED_SECRET=escolha_um_segredo_forte_aqui

# Porta em que o serviço vai escutar (a hospedagem geralmente define isso automaticamente)
PORT=3000

# Textos das 3 mensagens de reengajamento, em ordem
MSG_30MIN=Ei, ficou alguma dúvida?
MSG_1H=Ei, conseguiu comprar?
MSG_6H=Ei, deu tudo certo?
